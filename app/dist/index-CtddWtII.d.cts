  "voiture . thermique . carburant": "gazole B7 ou B10" | "essence E5 ou E10" | "essence E85" | "GPL" | null,
  "voiture . gabarit": "petite" | "moyenne" | "berline" | "SUV" | "VUL",
  "voiture . thermique . prix carburant": number | null,
  /** Âge de la voiture */
  "voiture . âge": number,
  "voiture . durée de détention totale": number,
  "voiture . cible . achat envisagé": boolean,
  "voiture . cible . occasion": boolean | null,
  "voiture . cible . âge": number | null,
  "voiture . cible . borne de recharge": boolean | null,
  "voiture . cible . gabarit": "petite" | "moyenne" | "berline" | "SUV" | "VUL",
  "usage . km annuels . connus": boolean,
  "usage . km annuels . renseignés": number | null,
