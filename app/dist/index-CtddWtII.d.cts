  "coûts . coûts de possession . entretien": number,
  "coûts . coûts de possession . assurance": number,
  "coûts . coûts d'utilisation . stationnement": number,
  /** Coût annuel lié aux péages */
  "coûts . coûts d'utilisation . péage": number | null,
  "coûts . coûts d'utilisation . contraventions": number,
  "aides . bonus écologique": number | null
}>

/**
 * All rule names available in the model.
 */
type RuleName = keyof Situation

/**
 * Exports the personas object.
 *
 * It's defined in the `personas.yaml` file and allows to define named
 * situations that can be feed into the engine.
 */

type Persona = {
    titre: string;
    description?: string;
    contexte: Situation;
    empreinte: number;
    coûts: number;
};
/**
 * A set of named situations that can be feed into the engine and used for
 * testing purposes or to provide examples.
 */
declare const _default: Record<string, Persona>;

export { type Persona as P, type Questions as Q, type RuleValue as R, type Situation as S, _default as _, type RuleName as a };
